<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_bobine"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="ColoriseurSTL"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texte_principal" />

            <ImageButton
                android:id="@+id/btnParametres"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_parametres"
                android:contentDescription="Paramètres" />
        </LinearLayout>

        <!-- Source : dossier ou fichiers -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fichiers STL à coloriser"
                    android:textColor="@color/texte_principal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texteSourceChoisie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Aucune source choisie"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnChoisirDossier"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/fond_bouton_secondaire"
                        android:text="Dossier..."
                        android:textColor="@color/texte_principal"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btnChoisirFichiers"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/fond_bouton_secondaire"
                        android:text="Fichier(s)..."
                        android:textColor="@color/texte_principal"
                        android:textAllCaps="false" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Dossier de sortie -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dossier de sortie (.3mf colorisés)"
                    android:textColor="@color/texte_principal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texteDossierSortie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="Aucun dossier choisi"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnChoisirDossierSortie"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/fond_bouton_secondaire"
                    android:text="Choisir le dossier de sortie..."
                    android:textColor="@color/texte_principal"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Style / prompt -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Style voulu"
                    android:textColor="@color/texte_principal"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/menuPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/editPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Prompt envoyé à Meshy (modifiable)" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Nombre de couleurs"
                    android:textColor="@color/texte_principal"
                    android:textStyle="bold" />

                <NumberPicker
                    android:id="@+id/selecteurCouleurs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnLancer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="Lancer la colorisation"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Onglets manuels (sans dependance TabLayout) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/ongletFichiers"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Fichiers STL"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ongletResultats"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Résultats"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ongletAvancement"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="Avancement"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/texteCompteurGalerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/texte_secondaire"
            android:textSize="12sp" />

        <GridLayout
            android:id="@+id/galerieFichiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:visibility="visible" />

        <GridLayout
            android:id="@+id/galerieResultats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/texteJournal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp"
            android:background="@color/carte_blanc"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
