<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Contrairement aux lecteurs RFID (100% hors ligne), cette appli a besoin d'Internet pour
         appeler l'API Meshy - a bien signaler dans le README/forum, c'est un vrai changement. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Necessaire pour ConnectivityManager.getNetworkCapabilities() (fonction "Wi-Fi
         uniquement") - oubliee lors de l'ajout de cette fonction, corrige ici. Sans elle, l'appel
         peut lever une SecurityException non rattrapee des que ce reglage est actif. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Service en premier plan : le traitement continue meme si l'appli est quittee ou mise en
         arriere-plan longtemps. "dataSync" est le type le plus proche de la realite (appels
         reseau + ecriture de fichiers), requis explicitement depuis Android 14 (API 34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ (API 33) : obligatoire pour afficher la notification de progression du
         service. Demandee a l'utilisateur au premier lancement (voir MainActivity) ; si refusee,
         le service continue de fonctionner, juste sans notification visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ColoriseurSTL"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <service
            android:name=".ColorisationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
